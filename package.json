{
  "name": "autofill-forms",
  "version": "2.0.0",
  "description": "Autofill Forms browser extension",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fuongz/autofill-forms.git"
  },
  "scripts": {
    "clean": "rm -rf extension/dist",
    "build:background": "bun build src/background/index.ts --outfile=extension/dist/background.js --target=browser --format=esm",
    "build:content": "bun build src/content/index.ts --outfile=extension/dist/content.js --target=browser --format=iife",
    "build:popup:js": "bun build src/popup/index.ts --outfile=extension/dist/popup/popup.js --target=browser --format=esm",
    "build:popup:assets": "mkdir -p extension/dist/popup && cp src/popup/index.html extension/dist/popup/index.html && cp src/popup/style.css extension/dist/popup/style.css",
    "build:popup": "bun run build:popup:js && bun run build:popup:assets",
    "build": "bun run clean && bun run build:background && bun run build:content && bun run build:popup",
    "dev:background": "bun build src/background/index.ts --outfile=extension/dist/background.js --target=browser --format=esm --watch",
    "dev:content": "bun build src/content/index.ts --outfile=extension/dist/content.js --target=browser --format=iife --watch",
    "dev:popup": "bun build src/popup/index.ts --outfile=extension/dist/popup/popup.js --target=browser --format=esm --watch",
    "dev": "bun run build:popup:assets && (bun run dev:background & bun run dev:content & bun run dev:popup && wait)",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/chrome": "^0.0.290",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=18.12.0"
  }
}
